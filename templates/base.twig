<!DOCTYPE html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta name="csrf-token" content="{{ csrf_token }}">
					<title>{% block title %}{{ app_name }}{% endblock %}</title>
					<script src="assets/js/theme.js"></script>
					<link rel="stylesheet" href="assets/css/style.css">
</head>
	<body>
		<header class="site-header">
			<a class="brand" href="index.php?page=home">&#9876; {{ app_name }}</a>

			<nav aria-label="Main">
				<a href="index.php?page=home" class="{{ current_page == 'home' ? 'on' : '' }}">Home</a>
				<a href="index.php?page=forum" class="{{ current_page == 'forum' ? 'on' : '' }}">Forum</a>
				{% if current_user %}
				<a href="index.php?page=dashboard" class="{{ current_page == 'dashboard' ? 'on' : '' }}">Dashboard</a>
				<a href="index.php?page=quests" class="{{ current_page starts with 'quest' ? 'on' : '' }}">My Quests</a>
				<a href="index.php?page=leaderboard" class="{{ current_page == 'leaderboard' ? 'on' : '' }}">Leaderboard</a>
				{% if current_user.role == 'admin' %}
				<a href="index.php?page=admin" class="{{ current_page starts with 'admin' ? 'on' : '' }}">Admin</a>
				{% endif %}
				{% endif %}
				<span class="nav-spacer"></span>
				{% if current_user %}
				<a class="nav-user {{ current_page starts with 'profile' ? 'on' : '' }}" href="index.php?page=profile">
				<span class="avatar">{{ current_user.username|first|upper }}</span>{{ current_user.username }}
				</a>
				<form method="post" action="index.php?page=logout" class="inline-form">
					<input type="hidden" name="csrf_token" value="{{ csrf_token }}">
						<button type="submit" class="btn-link">Log out</button>
					</form>
				{% else %}
				<a href="index.php?page=login" class="{{ current_page == 'login' ? 'on' : '' }}">Log in</a>
				<a href="index.php?page=register" class="{{ current_page == 'register' ? 'on' : '' }}">Register</a>
				{% endif %}
				<button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle dark mode" aria-pressed="false">&#9680;</button>
			</nav>
		</header>

		<main class="container">
			{% include 'partials/flash.twig' %}
			{% block content %}{% endblock %}
		</main>

		<footer class="site-footer">
			<p>
				&copy; {{ "now"|date("Y") }} {{ app_name }} &middot;
				<a href="index.php?page=terms">Terms</a> &middot;
				<a href="index.php?page=privacy_policy">Privacy</a> &middot;
				<a href="index.php?page=community_rules">Community rules</a>
			</p>
		</footer>

		<script src="assets/js/app.js"></script>
		{% block scripts %}{% endblock %}
	</body>
</html>