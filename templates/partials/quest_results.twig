<p class="result-count">
	{{ quests|length }} quest{{ quests|length == 1 ? '' : 's' }}{% if has_filters %} found{% endif %}
</p>

{% if quests is empty %}
<div class="card">
	{% if has_filters %}
	<p>No quests match those filters. Try removing one.</p>
	{% else %}
	<p>No quests yet. New quests arrive here as you play.</p>
	{% endif %}
</div>
{% else %}
<div class="quest-list">
	{% for q in quests %}
	{% set blurb = q.summary ?: q.description %}
	<article class="quest {{ q.status == 'completed' ? 'quest-done' : '' }}"
			 data-border="{{ q.category_color }}" data-id="{{ q.id }}">
		<div class="quest-main">
			<h3>{{ q.title }}</h3>
			{% if blurb %}<p>{{ blurb|length > 140 ? blurb|slice(0, 140) ~ '...' : blurb }}</p>{% endif %}
			<p class="meta">
				<span class="tag" data-bg="{{ q.category_color }}">{{ q.category_name }}</span>
				<span class="tag tag-type">{{ q.quest_type|capitalize }}</span>
				<span class="tag tag-{{ q.difficulty }}">{{ q.difficulty|capitalize }}</span>
				<strong>+{{ q.xp_reward }} XP</strong>
				{% if q.time_left %}
				<span class="time-left {{ q.time_left.urgent ? 'urgent' : '' }}">&middot; {{ q.time_left.text }}</span>
				{% elseif q.due_date and q.status == 'active' %}
				&middot; Due {{ q.due_date|date('d M Y') }}
				{% endif %}
			</p>
		</div>
		<div class="quest-actions">
			{% if q.status == 'completed' %}<span class="tag tag-done">Completed</span>{% endif %}
			<a class="btn btn-small btn-secondary js-open-quest" href="index.php?page=quest_view&amp;id={{ q.id }}">View</a>
		</div>
	</article>
	{% endfor %}
</div>
{% endif %}