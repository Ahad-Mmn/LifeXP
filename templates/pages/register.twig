{% extends "base.twig" %}

{% block title %}Register | {{ app_name }}{% endblock %}

{% block content %}
<div class="card">
    <h2>Create your hero</h2>
    {% include 'partials/errors.twig' %}

    <form method="post" action="index.php?page=register" novalidate>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <label for="username">Username</label>
        <input type="text" id="username" name="username" value="{{ old.username }}"
               maxlength="20" autocomplete="username" data-check-username required>
        <span id="username-status" class="field-status" aria-live="polite"></span>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{ old.email }}"
               maxlength="255" autocomplete="email" required>

        <label for="password">Password (8+ characters, letters and numbers)</label>
        <input type="password" id="password" name="password" maxlength="72"
               autocomplete="new-password" required>

        <label for="password_confirm">Confirm password</label>
        <input type="password" id="password_confirm" name="password_confirm" maxlength="72"
               autocomplete="new-password" required>

        <label for="captcha">Are you human? What is {{ captcha_question }} ?</label>
        <input type="text" id="captcha" name="captcha" maxlength="4" autocomplete="off" required>

        <button type="submit" class="btn">Start my adventure</button>
    </form>
    <p>Already a hero? <a href="index.php?page=login">Log in</a></p>
</div>
{% endblock %}