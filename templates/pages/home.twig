{% extends "base.twig" %}

{% block title %}Home | {{ app_name }}{% endblock %}

{% block content %}
    <h2>Turn real life into an RPG</h2>
    <p>Complete everyday quests, earn XP and level up.</p>

    {% if not current_user %}
        <p>
            <a class="btn" href="index.php?page=register">Register</a>
            <a class="btn btn-secondary" href="index.php?page=login">Log in</a>
        </p>
    {% endif %}

    <h3>Quest categories</h3>
    <ul>
        {% for c in categories %}
            <li style="color: {{ c.color }};">{{ c.name }}</li>
        {% endfor %}
    </ul>
{% endblock %}