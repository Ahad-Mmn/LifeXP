{% extends "base.twig" %}

{% block title %}Home | {{ app_name }}{% endblock %}

{% block content %}
    <h2>Welcome, {{ player }}!</h2>
    <p>Your adventure begins here. Twig is working.</p>

    {% if db_error %}
        <p style="color:#f87171;">Database error: {{ db_error }}</p>
    {% else %}
        <h3>Quest categories (read from MySQL)</h3>
        <ul>
            {% for c in categories %}
                <li style="color: {{ c.color }};">{{ c.name }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}